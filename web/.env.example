# Copy to web/.env.local (git-ignored) and fill in. Save each secret with
#   scripts/set-secret.sh web/.env.local <NAME>
# which takes the value at a hidden prompt. web/lib/env.ts checks every value when first used,
# so the build, the tests and /demo run with none of these set.

# Supabase. The URL and publishable key are public: they reach the browser.
# Cloud: Dashboard > Project Settings > API Keys. Local stack: `supabase status`
# (API_URL is http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret: bypasses RLS. Use web's own key (`vercel-web`), not the worker's.
SUPABASE_SECRET_KEY=

# Secret: question generation through OpenRouter.
OPENROUTER_API_KEY=

# Secret, shared with the ingest worker, which sends it on every callback. Make one with
#   openssl rand -hex 32
INGEST_CALLBACK_SECRET=

# Accounts can be created only while this is exactly "true".
SIGNUPS_ENABLED=false

# Generation starts no new model call once today's (UTC) spend reaches this, in US dollars.
DAILY_BUDGET_USD=1

# Cloudflare Turnstile, the human check before a guest deck starts. Guest decks are off unless
# both are set. The site key is public and inlined into the landing page at build time; the
# secret is not. Locally, Cloudflare's always-pass test keys work:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret.
TURNSTILE_SECRET_KEY=

# Copy to ingest/.env (git-ignored, and kept out of the image by .dockerignore) and pass it with
#   docker run --env-file ingest/.env ...
# Save each secret with scripts/set-secret.sh ingest/.env <NAME>, which takes it at a hidden prompt.

# Supabase over HTTPS only: PostgREST for the job functions, Storage for files. Plain http is
# accepted only for a stack on this machine: http://host.docker.internal:54321 from a container.
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret: the worker's own key (`ingest-worker`), so it can be revoked without touching web's.
SUPABASE_SECRET_KEY=

# Where to tell web an extraction finished, and the secret web checks (the same value as
# INGEST_CALLBACK_SECRET in web/.env.local). Leave the URL empty to skip the callback: the
# document then waits as `extracted`.
INGEST_CALLBACK_URL=https://figurequiz.online/api/ingest/callback
INGEST_CALLBACK_SECRET=
